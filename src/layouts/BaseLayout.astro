---
import "../styles/global.css";
import Header from "../components/navigation/Header.astro";
import Footer from "../components/navigation/Footer.astro";
import SubscribeModal from "../components/navigation/SubscribeModal.astro";
import { site } from "../data/site";
import { contentUrl } from "../lib/urls";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogTitle?: string;
  ogType?: "website" | "article";
  canonicalPath?: string;
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
  robots?: string;
}

const {
  title = site.title,
  description = site.description,
  ogImage = "/social/og-default.jpg",
  ogImageAlt = "Lookout West — research, data, and decisions in the American West.",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogTitle = title,
  ogType = "website",
  canonicalPath = Astro.url.pathname,
  publishDate,
  updatedDate,
  author,
  robots = "index,follow,max-image-preview:none",
} = Astro.props;

const canonical = contentUrl(canonicalPath);
const absoluteOgImage = new URL(ogImage, site.siteUrl).toString();
const rssUrl = new URL("/rss.xml", site.siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#F4F4F0" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lookout West RSS"
      href={rssUrl}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    {
      ogType === "article" && publishDate && (
        <meta
          property="article:published_time"
          content={publishDate.toISOString()}
        />
      )
    }
    {
      ogType === "article" && updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
    {ogType === "article" && author && <meta name="author" content={author} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SubscribeModal />
  </body>
</html>
