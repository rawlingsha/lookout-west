---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  // Drafts are reviewable locally, but never receive a production article route.
  const visibleArticles = articles.filter(
    (article) => import.meta.env.DEV || !article.data.draft,
  );

  return visibleArticles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const sources = article.data.sources ?? [];
const toTopicSlug = (value: string) =>
  value.toLowerCase().trim().replace(/\s+/g, "-");

const primaryTopicSlug = toTopicSlug(
  article.data.topics?.[0] ?? article.data.topic,
);
---

<ArticleLayout
  id={article.id}
  title={article.data.title}
  deck={article.data.deck}
  topic={article.data.topic}
  topicHref={`/research/topics/${primaryTopicSlug}/`}
  author={article.data.author}
  publishDate={article.data.publishDate}
  draft={article.data.draft}
  format={article.data.format}
  updatedDate={article.data.updatedDate}
  hasSources={sources.length > 0}
  seoTitle={article.data.seoTitle}
  seoDescription={article.data.seoDescription}
  socialTitle={article.data.socialTitle}
  shareText={article.data.shareText}
  socialImageAlt={article.data.socialImageAlt}
>
  <Content />

  {
    sources.length > 0 && (
      <Fragment slot="sources">
        <ol class="article-sources">
          {sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.title}
              </a>

              {(source.publisher || source.published || source.note) && (
                <span class="article-source__meta">
                  {[source.publisher, source.published, source.note]
                    .filter(Boolean)
                    .join(" • ")}
                </span>
              )}
            </li>
          ))}
        </ol>
      </Fragment>
    )
  }
</ArticleLayout>
