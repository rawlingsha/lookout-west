---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import sharp from "sharp";
import path from "node:path";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const publishedArticles = articles.filter((article) => !article.data.draft);

  return publishedArticles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const sources = article.data.sources ?? [];
const socialImageInfo = article.data.socialImage
  ? await sharp(
      path.join(process.cwd(), "public", article.data.socialImage),
    ).metadata()
  : undefined;

const toTopicSlug = (value: string) =>
  value.toLowerCase().trim().replace(/\s+/g, "-");

const primaryTopicSlug = toTopicSlug(
  article.data.topics?.[0] ?? article.data.topic,
);
---

<ArticleLayout
  id={article.id}
  title={article.data.title}
  deck={article.data.deck}
  topic={article.data.topic}
  topicHref={`/research/topics/${primaryTopicSlug}/`}
  author={article.data.author}
  publishDate={article.data.publishDate}
  updatedDate={article.data.updatedDate}
  hasSources={sources.length > 0}
  seoTitle={article.data.seoTitle}
  seoDescription={article.data.seoDescription}
  socialImage={article.data.socialImage}
  socialImageAlt={article.data.socialImageAlt}
  socialImageWidth={socialImageInfo?.width}
  socialImageHeight={socialImageInfo?.height}
>
  <Content />

  {
    sources.length > 0 && (
      <Fragment slot="sources">
        <ol class="article-sources">
          {sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.title}
              </a>

              {(source.publisher || source.published || source.note) && (
                <span class="article-source__meta">
                  {[source.publisher, source.published, source.note]
                    .filter(Boolean)
                    .join(" • ")}
                </span>
              )}
            </li>
          ))}
        </ol>
      </Fragment>
    )
  }
</ArticleLayout>
