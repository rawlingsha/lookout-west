---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/base/Container.astro";
import Edition from "../../components/current/Edition.astro";
import {
  getCurrentEditions,
  currentDate,
  editionHref,
} from "../../lib/current";
import "../../styles/current.css";
import { currentShareImages } from "../../lib/share";
export async function getStaticPaths() {
  return (await getCurrentEditions(import.meta.env.DEV)).map((edition) => ({
    params: { date: edition.date },
    props: { edition },
  }));
}
const { edition } = Astro.props;
const images = currentShareImages(edition.draft ? undefined : edition.date);
---

<BaseLayout
  title={`The Current — ${currentDate(edition.date)} | Lookout West`}
  description={edition.deck ?? edition.signals[0].headline}
  canonicalPath={editionHref(edition)}
  robots={edition.draft ? "noindex,nofollow" : undefined}
  ogType="article"
  ogTitle={edition.socialTitle ?? `The Current — ${currentDate(edition.date)}`}
  ogImage={images.preview}
  ogImageAlt={images.alt}
  ogImageWidth={images.width}
  ogImageHeight={images.height}
  updatedDate={edition.updatedDate
    ? new globalThis.Date(edition.updatedDate)
    : undefined}
  publishDate={new globalThis.Date(edition.date)}
>
  <Container
    ><div class="current-page"><Edition edition={edition} /></div></Container
  >
</BaseLayout>
