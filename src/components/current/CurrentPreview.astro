---
import type { CurrentEdition } from "../../lib/current-schema";
import { currentDate, editionHref } from "../../lib/current";
interface Props {
  edition?: CurrentEdition;
  preview?: boolean;
}
const { edition, preview = false } = Astro.props;
const href = preview
  ? "/current/preview/"
  : edition
    ? editionHref(edition)
    : "/current/";
---

<section class="current-preview" aria-labelledby="current-preview-title">
  <div class="current-preview__meta">
    <h2 id="current-preview-title">The Current</h2>
    {
      edition ? (
        <time datetime={edition.date}>{currentDate(edition.date)}</time>
      ) : (
        <span>Forthcoming</span>
      )
    }
  </div>
  {
    edition ? (
      <div class="current-preview__body">
        <div>
          <h3>
            <a href={href}>{edition.signals[0].headline}</a>
          </h3>
          <p>{edition.deck ?? edition.signals[0].body.split(/\n\s*\n/)[0]}</p>
        </div>
        <ul>
          {edition.signals.slice(1, 4).map((signal) => (
            <li>
              <a href={`${href}#${signal.id}`}>{signal.headline}</a>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <p>
        Concise economic briefings on the American West. The first edition is
        forthcoming.
      </p>
    )
  }
  <a class="current-preview__link" href={href}
    >Read The Current <span aria-hidden="true">→</span></a
  >
</section>
<style>
  .current-preview {
    border-top: var(--border-subtle);
    padding-block: var(--space-6) var(--space-7);
  }
  .current-preview__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: baseline;
    margin-bottom: var(--space-5);
  }
  h2 {
    font-family: var(--font-sans);
    color: var(--color-accent);
    text-transform: uppercase;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    margin: 0;
  }
  time,
  .current-preview__meta span {
    color: var(--color-muted);
    font-size: var(--step--1);
  }
  h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  p {
    max-width: 42rem;
    color: var(--color-muted);
    line-height: 1.7;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding-block: var(--space-3);
    border-top: var(--border-subtle);
  }
  .current-preview__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--step--1);
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  @media (min-width: 56rem) {
    .current-preview__body {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
</style>
