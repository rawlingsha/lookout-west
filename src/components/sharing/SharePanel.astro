---
import {
  shareDestinations,
  type ShareImages,
  type SharePayload,
} from "../../lib/share";
interface Props extends SharePayload {
  id: string;
  kind: string;
  images?: ShareImages;
}
const { id, title, url, text, kind, images } = Astro.props;
---

<div class="share-panel" data-share-panel>
  <div class="share-panel__heading">
    <h2 id={`${id}-heading`}>Share this {kind}</h2>
    <button
      class="share-close"
      type="button"
      data-share-close
      aria-label="Close sharing options"
      hidden>×</button
    >
  </div>
  <div class="share-destinations" aria-label="Sharing destinations">
    <button class="share-destination" type="button" data-copy-link hidden
      ><span data-copy-label>Copy link</span></button
    >
    {
      shareDestinations({ title, url, text }).map(({ name, href }) => (
        <a
          class="share-destination"
          href={href}
          target={name === "Email" ? undefined : "_blank"}
          rel={name === "Email" ? undefined : "noopener noreferrer"}
        >
          {name}
          <span aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>
  <details class="share-helper" data-image-helper>
    <summary>Instagram images <span aria-hidden="true">+</span></summary>
    <p>
      Save an image, then add it in Instagram. Copy the link and add it yourself
      using a Story link sticker or a message. If Safari opens the image, touch
      and hold it to save it to Photos.
    </p>
    {
      images && (
        <div class="share-helper__actions">
          <button
            class="share-control"
            type="button"
            data-share-image={images.story}
            hidden
          >
            Share Story image
          </button>
          <a class="share-control" href={images.story} download>
            Download Story image ↓
          </a>
          <a class="share-control" href={images.portrait} download>
            Download Post image ↓
          </a>
        </div>
      )
    }
    <button class="share-control" type="button" data-copy-link hidden
      ><span data-copy-label>Copy {kind} link</span></button
    >
  </details>
  <details class="share-helper">
    <summary>Substack Notes <span aria-hidden="true">+</span></summary>
    <p>Copy this link, then paste it into a new note on Substack.</p>
    <div class="share-helper__actions">
      <button class="share-control" type="button" data-copy-link hidden
        ><span data-copy-label>Copy link</span></button
      >
      <a
        class="share-control"
        href="https://substack.com/notes"
        target="_blank"
        rel="noopener noreferrer">Open Notes ↗</a
      >
    </div>
  </details>
  <div class="share-link-field" data-manual-copy>
    <label for={`${id}-url`}>Link to this {kind}</label>
    <input
      id={`${id}-url`}
      type="text"
      inputmode="url"
      value={url}
      readonly
      data-share-url
      aria-describedby={`${id}-status`}
    />
  </div>
  <p
    id={`${id}-status`}
    class="share-status"
    role="status"
    aria-live="polite"
    data-panel-status
  >
  </p>
</div>
