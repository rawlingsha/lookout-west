---
import SharePanel from "./SharePanel.astro";
import type { ShareImages, SharePayload } from "../../lib/share";
import "../../styles/sharing.css";

interface Props extends SharePayload {
  id: string;
  kind?: "article" | "edition" | "chart" | "table";
  images?: ShareImages;
  download?: string;
  label?: string;
}
const {
  id,
  title,
  url,
  text = "",
  kind = "article",
  images,
  download,
  label,
} = Astro.props;
const shareLabel = kind === "article" ? "Share" : `Share this ${kind}`;
const copyLabel =
  kind === "chart" || kind === "table" ? `Copy ${kind} link` : "Copy link";
---

<div
  class="share-actions"
  data-share-actions
  data-url={url}
  data-title={title}
  data-text={text}
>
  {label && <p class="share-actions__label">{label}</p>}
  <div class="share-actions__controls">
    <button
      class="share-control"
      type="button"
      data-share-trigger
      aria-label={`Share this ${kind}`}
      hidden>{shareLabel}</button
    >
    <details class="share-disclosure" data-share-disclosure>
      <summary class="share-control" aria-label={`Share this ${kind}`}
        >{shareLabel}</summary
      >
      <SharePanel
        id={id}
        title={title}
        url={url}
        text={text}
        kind={kind}
        images={images}
      />
    </details>
    <button class="share-control" type="button" data-copy-link hidden
      ><span data-copy-label>{copyLabel}</span></button
    >
    {
      download && (
        <a class="share-control" href={download} download>
          Download {kind} <span aria-hidden="true">↓</span>
        </a>
      )
    }
    <button class="share-more" type="button" data-share-options hidden
      >More sharing options</button
    >
  </div>
  <p class="share-status" role="status" aria-live="polite" data-share-status>
  </p>
</div>

<script>
  import "../../scripts/share-actions";
</script>
