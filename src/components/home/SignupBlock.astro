---
import SubscribeForm from "../navigation/SubscribeForm.astro";

interface Props {
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { secondaryHref = "/research", secondaryLabel = "Browse research" } =
  Astro.props;
---

<section class="signup-block" aria-labelledby="signup-block-title">
  <p class="signup-block__label">Subscribe</p>
  <h2 id="signup-block-title" class="signup-block__title">
    The West, in your inbox.
  </h2>
  <p class="signup-block__deck">
    New essays, research, and notes from Lookout West.
  </p>

  <div class="signup-block__actions">
    <SubscribeForm id="home-subscribe" />
    <a class="signup-block__browse" href={secondaryHref}>{secondaryLabel} →</a>
  </div>
</section>

<style>
  .signup-block {
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
    border-top: var(--border-subtle);
  }

  .signup-block__label {
    margin: 0;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--step--1);
    font-weight: 600;
  }

  .signup-block__title {
    margin: var(--space-2) 0 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .signup-block__deck {
    margin-top: var(--space-4);
    max-width: 42rem;
    color: var(--color-muted);
    font-size: var(--step-1);
    line-height: 1.7;
  }

  .signup-block__actions {
    max-width: 32rem;
    margin-top: var(--space-5);
  }

  .signup-block__browse {
    display: inline-block;
    margin-top: var(--space-5);
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 56rem) {
    .signup-block {
      padding-top: var(--space-6);
      padding-bottom: var(--space-7);
    }

    .signup-block__deck {
      font-size: 1.0625rem;
    }
  }
</style>
