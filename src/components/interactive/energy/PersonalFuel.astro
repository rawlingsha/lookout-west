---
import { energyData, energySource } from "../../../lib/interactive/energy/data";
import {
  fuelDistribution,
  statePriceRows,
} from "../../../lib/interactive/energy/personal-model";
import "../../../styles/energy-personal.css";
const states = statePriceRows(energyData.metrics);
const d = fuelDistribution(energyData.metrics, "gasoline", "NM");
---

<section
  id="your-bill"
  class="energy-personal"
  data-energy-personal
  data-fuel="gasoline"
  data-price-data={JSON.stringify(
    energyData.metrics.filter((m) => m.id !== "electricity"),
  )}
  aria-labelledby="personal-heading"
>
  <header>
    <p class="energy-kicker">At Western pumps</p><h2 id="personal-heading">
      What a pump change means for a month of driving.
    </h2>
  </header>
  <div class="personal-observed" id="compare-states">
    <div class="personal-selection">
      <div data-state-control hidden>
        <label for="energy-state" data-selection-label>Example state</label
        ><select id="energy-state" data-state-select
          >{
            states.map((s) => (
              <option value={s.code} selected={s.code === "NM"}>
                {s.name}
              </option>
            ))
          }</select
        >
      </div>
      <p class="personal-static" data-state-fallback>Example · New Mexico</p>
      <fieldset data-metric-controls hidden>
        <legend class="energy-sr-only">Pump fuel</legend><label
          ><input
            type="radio"
            name="energy-metric"
            value="gasoline"
            checked
          />Regular gasoline</label
        ><label
          ><input
            type="radio"
            name="energy-metric"
            value="diesel"
          />Diesel</label
        >
      </fieldset>
    </div>
    <div class="personal-price">
      <p>
        <strong data-selected-value>${d.selected.value.toFixed(2)}</strong><span
          >per gallon · <span data-fuel-label>regular gasoline</span></span
        >
      </p>
      <p class="personal-position">
        <span data-selected-name>New Mexico</span><br /><span data-position
          >{d.rank} of 13, from lowest price</span
        >
      </p>
    </div>
    <div class="personal-distribution" aria-hidden="true">
      <div class="personal-dots">
        {
          d.dots.map((dot) => (
            <i
              data-state-dot={dot.code}
              style={`left:${dot.x}%;top:${dot.lane * 14}px`}
            />
          ))
        }<span
          class="personal-pin"
          data-selected-code
          style={`left:${d.selected.x}%;--stem:${d.selected.lane * 14 + 20}px`}
          >NM</span
        ><b
          data-selected-marker
          style={`left:${d.selected.x}%;top:${d.selected.lane * 14}px`}></b>
      </div>
      <div class="personal-axis">
        <span>${d.min.toFixed(2)}</span><span
          >${((d.min + d.max) / 2).toFixed(2)}</span
        ><span>${d.max.toFixed(2)}</span>
      </div>
    </div>
    <div class="personal-range">
      <span data-range-low>Lowest · {d.low.name} ${d.low.value.toFixed(2)}</span
      ><span data-range-high
        >Highest · {d.high.name} ${d.high.value.toFixed(2)}</span
      >
    </div>
    <p class="personal-source">
      13 dots, one per state · <time datetime="2026-09-19"
        >September 19, 2026</time
      > · <a href={energySource("aaa").url}>AAA daily averages</a>
    </p>
    <p class="personal-caveat" data-fuel-caveat>
      Regular gasoline includes taxes. State averages vary from individual
      stations.
    </p>
    <p class="energy-sr-only" role="status" data-metric-status></p>
  </div>
  <section
    id="fuel-budget"
    class="personal-household"
    data-energy-budget
    aria-labelledby="fuel-budget-heading"
  >
    <h3 id="fuel-budget-heading">Put a price change in your monthly budget.</h3>
    <p class="personal-assumption">
      An illustration, not a forecast. Choose a change in the price of
      <span data-equation-fuel>gasoline</span>, holding your fuel use constant.
      The state average above does not set this price change.
    </p>
    <p data-budget-fallback>
      At 60 gallons a month, a $1 increase per gallon adds $60 a month.
      If the same difference held for two months: $120.
    </p>
    <div data-budget-controls hidden>
      <div class="personal-equation">
        <div class="personal-term">
          <label for="energy-gallons">Gallons per month</label>
          <input
            id="energy-gallons"
            type="number"
            inputmode="numeric"
            min="0"
            max="500"
            step="1"
            value="60"
            required
            aria-describedby="gallons-help gallons-error"
          />
          <div class="personal-field-note">
            <p id="gallons-help" class="personal-input-help">0–500 gallons, in whole numbers.</p>
            <p id="gallons-error" hidden></p>
          </div>
        </div>
        <span class="personal-operator" aria-hidden="true">×</span>
        <div class="personal-term">
          <label for="energy-price">Price change ($ per gallon)</label>
          <input
            id="energy-price"
            type="number"
            inputmode="decimal"
            min="-2"
            max="2"
            step="0.05"
            value="1.00"
            required
            aria-describedby="price-help price-error"
          />
          <div class="personal-field-note">
            <p id="price-help" class="personal-input-help">−$2 to +$2, in 5-cent steps. Negative means a price drop.</p>
            <p id="price-error" hidden></p>
          </div>
        </div>
        <span class="personal-equals" aria-hidden="true">=</span>
        <div class="personal-answer">
          <span>Monthly spending change</span>
          <strong data-budget-result><span data-monthly>+$60</span></strong>
          <strong data-invalid-result hidden aria-hidden="true">—</strong>
          <p class="personal-duration">
            If the same difference held for two months:
            <span data-two-month>+$120</span>
          </p>
        </div>
      </div>
      <div class="personal-examples">
        <span>Try a price change:</span>
        <button type="button" data-price-preset="-0.50">−50¢</button>
        <button type="button" data-price-preset="0.50">+50¢</button>
        <button type="button" data-price-preset="1.00">+$1</button>
        <button type="button" data-budget-reset>Reset example</button>
      </div>
      <p class="energy-sr-only" data-budget-description></p>
      <p class="personal-privacy">Calculated in your browser. Your entries are not stored or sent anywhere.</p>
    </div>
    <p class="energy-sr-only" role="status" aria-atomic="true" data-budget-status></p>
  </section>
</section>
