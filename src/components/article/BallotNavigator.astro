---
const sections = [
  [
    "1-congress-control-over-the-the-next-federal-budget",
    "Congress and the federal budget"
  ],
  [
    "2-california-a-billionaire-tax-with-billions-at-stake",
    "California’s billionaire tax"
  ],
  [
    "3-colorado-your-tax-rate-your-refund-your-school-district",
    "Colorado taxes and refunds"
  ],
  [
    "4-texas-who-pays-after-oil-wells-stop-producing",
    "Texas oil-well cleanup"
  ],
  [
    "5-washington-repeal-an-income-tax-and-close-off-the-next-one",
    "Washington’s income tax"
  ],
  [
    "6-arizona-and-nevada-governing-the-next-building-boom",
    "Arizona and Nevada development and utilities"
  ],
  [
    "7-californians-affording-to-stay-in-california-paying-for-homes-vs-building-them",
    "California housing"
  ],
  [
    "8-south-dakota-a-medicaid-vote-with-competing-explanations",
    "South Dakota Medicaid"
  ],
  [
    "9-california-an-overlooked-tax-vote-may-prove-more-consequential",
    "California taxes and reserves"
  ],
  [
    "10-property-taxes-relief-depending-on-the-address-and-the-rules",
    "Wyoming, Oklahoma and Kansas property taxes"
  ],
  [
    "after-the-votes-are-counted",
    "Utah and Iowa’s rules for future tax decisions"
  ]
];
const issues = [
  { name: "Taxes & budgets", sections: [1, 2, 3, 5, 9] },
  { name: "Oil & gas", sections: [4] },
  { name: "Housing & development", sections: [6, 7] },
  { name: "Electricity", sections: [6] },
  { name: "Health coverage", sections: [8] },
  { name: "Property taxes", sections: [10] },
];
const states = [
  { name: "Alaska", sections: [1] },
  { name: "Arizona", sections: [6] },
  { name: "California", sections: [2, 7, 9] },
  { name: "Colorado", sections: [3] },
  { name: "Iowa", sections: [11] },
  { name: "Kansas", sections: [10] },
  { name: "Nebraska", sections: [1] },
  { name: "Nevada", sections: [6] },
  { name: "Oklahoma", sections: [10] },
  { name: "South Dakota", sections: [8] },
  { name: "Texas", sections: [1, 4] },
  { name: "Utah", sections: [11] },
  { name: "Washington", sections: [5] },
  { name: "Wyoming", sections: [10] },
];
---

<nav class="ballot-nav" aria-label="Explore the economic ballot" id="ballot-guide">
  <div class="ballot-nav__intro">
    <span class="ballot-nav__eyebrow">The ballot guide</span>
    <span class="ballot-nav__hint">Choose a section to jump in <span aria-hidden="true">↘</span></span>
  </div>
  <div class="ballot-nav__columns">
    {[{ title: "Find your issue", id: "issues", items: issues }, { title: "Find your state", id: "states", items: states }].map(group => (
      <section class={`ballot-nav__column ballot-nav__column--${group.id}`} aria-labelledby={`ballot-${group.id}`}>
        <h2 id={`ballot-${group.id}`}>{group.title}</h2>
        <ul class={`ballot-nav__list ballot-nav__list--${group.id}`}>
          {group.items.map(item => (
            <li>
              <span class="ballot-nav__name">{item.name}</span>
              <div class="ballot-nav__links">
                {item.sections.map(number => (
                  <a href={`#${sections[number - 1][0]}`} aria-label={`${item.name}: ${number === 11 ? "Closing discussion" : `Section ${number}`} — ${sections[number - 1][1]}`} title={sections[number - 1][1]}>
                    {number === 11 ? "Closing" : String(number).padStart(2, "0")}
                    {number === 11 && <span aria-hidden="true">↗</span>}
                  </a>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <div class="ballot-nav__footer">Numbers refer to the ten decisions below. <span>“Closing” links to the final discussion.</span></div>
</nav>

<style>
  .ballot-nav {
    margin-block: 2.5rem 3rem;
    border: var(--border-subtle);
    border-top: 3px solid var(--color-accent);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    background: rgba(255, 255, 255, 0.48);
    padding: 1.4rem 1.5rem 1rem;
  }
  .ballot-nav__intro { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding-bottom: 1.25rem; }
  .ballot-nav__eyebrow { font-size: .68rem; letter-spacing: .13em; text-transform: uppercase; font-weight: 650; color: var(--color-accent); }
  .ballot-nav__hint { font-size: .72rem; color: var(--color-muted); }
  .ballot-nav__hint span { margin-left: .25rem; color: var(--color-accent); }
  .ballot-nav__columns { display: grid; grid-template-columns: 1fr 1.1fr; gap: 1.5rem; }
  .ballot-nav__column--states { border-left: var(--border-subtle); padding-left: 1.5rem; }
  .ballot-nav h2 { margin: 0 0 1rem; font-family: var(--font-display); font-size: 1.55rem; font-weight: 400; line-height: 1.15; letter-spacing: -.035em; text-wrap: nowrap; }
  .ballot-nav .ballot-nav__list { list-style: none; padding: 0; margin: 0; }
  .ballot-nav__list--states { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: .85rem; }
  .ballot-nav .ballot-nav__list li { margin: 0; padding: .55rem 0 .5rem; border-top: var(--border-subtle); font-size: .8rem; line-height: 1.35; min-width: 0; }
  .ballot-nav__name { display: block; font-weight: 550; }
  .ballot-nav__links { display: flex; flex-wrap: wrap; gap: .25rem; margin-top: .35rem; }
  .ballot-nav a { display: inline-flex; gap: .35rem; align-items: center; justify-content: center; min-width: 2rem; min-height: 2rem; padding: .25rem .35rem; border: 1px solid rgba(74, 93, 68, .18); border-radius: .25rem; color: var(--color-accent); background: rgba(74, 93, 68, .035); font-size: .73rem; line-height: 1; font-weight: 600; font-variant-numeric: tabular-nums; text-decoration: none; transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease; }
  .ballot-nav a:hover { background: var(--color-accent); color: white; border-color: var(--color-accent); }
  .ballot-nav a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; background: var(--color-accent); color: white; }
  .ballot-nav__footer { border-top: var(--border-subtle); margin-top: 1rem; padding-top: .8rem; font-size: .68rem; line-height: 1.6; color: var(--color-muted); }
  .ballot-nav__footer span { display: inline-block; }
  :global(.lw-prose:has(.ballot-nav) h2) { scroll-margin-top: 7rem; }
  :global(.lw-prose:has(.ballot-nav) h2:target) { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; text-underline-offset: .2em; }
  @media (max-width: 600px) {
    .ballot-nav { padding: 1.15rem; }
    .ballot-nav__intro { flex-wrap: wrap; gap: .4rem; }
    .ballot-nav__columns { grid-template-columns: 1fr; gap: 1.75rem; }
    .ballot-nav__column--states { border-left: 0; padding-left: 0; }
    .ballot-nav__list--issues li { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .35rem .75rem; }
    .ballot-nav__links { margin-top: 0; }
    .ballot-nav__list--states .ballot-nav__links { margin-top: .35rem; }
    .ballot-nav a { min-width: 2.75rem; min-height: 2.75rem; }
    .ballot-nav__list--states { column-gap: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .ballot-nav a { transition: none; } }
</style>
